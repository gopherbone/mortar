+static void axp2202_status_test(struct kunit *test)
+{
+	unsigned int status0, status1;
+
+	/* No battery: unknown, whatever else is set. */
+	KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x20, 0x02, 50),
+			POWER_SUPPLY_STATUS_UNKNOWN);
+	/* Battery, no VBUS: discharging, even with a stale charge-done code. */
+	for (status1 = 0; status1 <= U8_MAX; status1++)
+		KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x08, status1, 100),
+				POWER_SUPPLY_STATUS_DISCHARGING);
+	for (status0 = 0x28, status1 = 1; status1 <= 3; status1++)
+		KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(status0, status1, 40),
+				POWER_SUPPLY_STATUS_CHARGING);
+	KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x28, 0x04, 97),
+			POWER_SUPPLY_STATUS_FULL);
+	KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x28, 0x05, 100),
+			POWER_SUPPLY_STATUS_FULL);
+	KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x28, 0x05, 60),
+			POWER_SUPPLY_STATUS_NOT_CHARGING);
+	KUNIT_EXPECT_EQ(test, axp2202_status_from_registers(0x28, 0x00, -1),
+			POWER_SUPPLY_STATUS_NOT_CHARGING);
+}
