+/* Stock axp2202_reset_mcu: pause charging around a gauge MCU reset. */
+static int axp2202_reset_gauge(struct regmap *map)
+{
+	int ret, restore;
+
+	ret = regmap_update_bits(map, AXP2202_MODULE_EN, AXP2202_CHARGER_ENABLE, 0);
+	if (ret)
+		return ret;
+	msleep(500);
+	ret = regmap_update_bits(map, AXP2202_RESET_CFG, AXP2202_GAUGE_RESET,
+				 AXP2202_GAUGE_RESET);
+	if (!ret)
+		ret = regmap_update_bits(map, AXP2202_RESET_CFG,
+					 AXP2202_GAUGE_RESET, 0);
+	msleep(500);
+	restore = regmap_update_bits(map, AXP2202_MODULE_EN, AXP2202_CHARGER_ENABLE,
+				     AXP2202_CHARGER_ENABLE);
+	return ret ?: restore;
+}
+
+/*
+ * Program the fuel gauge's battery model the way the stock probe does: only
+ * when the "model loaded" mark is clear (the PMIC keeps it while the battery
+ * stays connected), write it through the BROM window, reopen and verify it,
+ * mark it loaded, then restart the gauge MCU so it re-estimates from OCV.
+ */
+static int axp2202_load_model(struct axp2202_charger *charger, bool *loaded)
+{
+	struct device *dev = charger->dev;
+	struct regmap *map = charger->map;
+	unsigned int value;
+	int count, ret, close, reset, i;
+	u8 *model;
+
+	*loaded = false;
+	ret = regmap_read(map, AXP2202_GAUGE_CONFIG, &value);
+	if (ret)
+		return ret;
+	if (value & AXP2202_MODEL_LOADED)
+		return 0;
+
+	count = device_property_count_u8(dev->parent, AXP2202_MODEL_PROPERTY);
+	if (count <= 0 || count > AXP2202_MODEL_MAX) {
+		dev_warn(dev, "no battery model in the device tree; gauge left unprogrammed\n");
+		return 0;
+	}
+	model = kmalloc(count, GFP_KERNEL);
+	if (!model)
+		return -ENOMEM;
+	ret = device_property_read_u8_array(dev->parent, AXP2202_MODEL_PROPERTY,
+					    model, count);
+	if (ret)
+		goto out;
+
+	ret = regmap_update_bits(map, AXP2202_GAUGE_CONFIG, AXP2202_BROM_OPEN, 0);
+	if (!ret)
+		ret = regmap_update_bits(map, AXP2202_GAUGE_CONFIG,
+					 AXP2202_BROM_OPEN, AXP2202_BROM_OPEN);
+	for (i = 0; !ret && i < count; i++)
+		ret = regmap_write(map, AXP2202_BROM, model[i]);
+	if (!ret)
+		ret = regmap_update_bits(map, AXP2202_GAUGE_CONFIG,
+					 AXP2202_BROM_OPEN, 0);
+	if (!ret)
+		ret = regmap_update_bits(map, AXP2202_GAUGE_CONFIG,
+					 AXP2202_BROM_OPEN, AXP2202_BROM_OPEN);
+	for (i = 0; !ret && i < count; i++) {
+		ret = regmap_read(map, AXP2202_BROM, &value);
+		if (!ret && value != model[i]) {
+			dev_err(dev, "battery model byte %d reads %02x, wrote %02x\n",
+				i, value, model[i]);
+			ret = -EIO;
+		}
+	}
+	close = regmap_update_bits(map, AXP2202_GAUGE_CONFIG, AXP2202_BROM_OPEN, 0);
+	ret = ret ?: close;
+	if (!ret)
+		ret = regmap_update_bits(map, AXP2202_GAUGE_CONFIG,
+					 AXP2202_MODEL_LOADED, AXP2202_MODEL_LOADED);
+	reset = axp2202_reset_gauge(map);
+	ret = ret ?: reset;
+	*loaded = !ret;
+out:
+	kfree(model);
+	return ret;
+}
+
+static int axp2202_init_charger(struct axp2202_charger *charger)
+{
+	struct regmap *map = charger->map;
+	unsigned int value;
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(brick_charger_setup); i++) {
+		unsigned int reg = brick_charger_setup[i].reg;
+		unsigned int mask = brick_charger_setup[i].mask;
+
+		ret = regmap_update_bits(map, reg, mask, brick_charger_setup[i].value);
+		if (!ret)
+			ret = regmap_read(map, reg, &value);
+		if (!ret && (value & mask) != brick_charger_setup[i].value)
+			ret = -EIO;
+		/* TS/JEITA/warning setup is protective, not required to charge. */
+		if (ret)
+			dev_warn(charger->dev, "charger setup reg %02x: %d\n", reg, ret);
+	}
+
+	/* Never charge above the stock 4.2 V; fail rather than guess. */
+	ret = regmap_update_bits(map, AXP2202_CHARGE_VOLTAGE, AXP2202_CV_MASK,
+				 AXP2202_CV_4200MV);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, AXP2202_CHARGE_VOLTAGE, &value);
+	if (ret)
+		return ret;
+	return (value & AXP2202_CV_MASK) == AXP2202_CV_4200MV ? 0 : -EIO;
+}
+
+/*
+ * Stock axp2202_bat_power_monitor: the gauge's coulomb counter (indirect
+ * register 0x2e) must read 0 (or 0xffff, not yet valid); anything else is an
+ * overflow that wedges the estimate until the gauge MCU restarts. Rate
+ * limited here, since a reset pauses charging for a second.
+ */
+static void axp2202_check_gauge(struct axp2202_charger *charger)
+{
+	struct regmap *map = charger->map;
+	unsigned int value, count;
+	u8 data[2];
+
+	mutex_lock(&charger->lock);
+	if (charger->suspended)
+		goto out;
+	if (regmap_write(map, AXP2202_GAUGE_ADDR, AXP2202_GAUGE_COULOMB) ||
+	    regmap_read(map, AXP2202_GAUGE_CONFIG, &value) ||
+	    !(value & AXP2202_MODEL_LOADED) ||
+	    regmap_read(map, AXP2202_GAUGE_ADDR, &value) ||
+	    value != AXP2202_GAUGE_COULOMB ||
+	    regmap_bulk_read(map, AXP2202_GAUGE_DATA, data, sizeof(data)))
+		goto out;
+	count = (data[0] << 8) | data[1];
+	if (!count || count == 0xffff)
+		goto out;
+	if (charger->gauge_reset_jiffies &&
+	    time_before(jiffies, charger->gauge_reset_jiffies + 600 * HZ))
+		goto out;
+	dev_warn(charger->dev, "gauge coulomb counter overflow (%04x), resetting gauge\n",
+		 count);
+	if (axp2202_reset_gauge(map))
+		dev_err(charger->dev, "gauge reset failed\n");
+	charger->gauge_reset_jiffies = jiffies ?: 1;
+out:
+	mutex_unlock(&charger->lock);
 }
 
