+static int axp2202_battery_status(struct regmap *map, int *status)
+{
+	unsigned int status0, status1;
+	int voltage, soc, ret;
+
+	ret = axp2202_voltage(map, &voltage);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, AXP2202_STATUS, &status0);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, AXP2202_CHARGE_STATUS, &status1);
+	if (ret)
+		return ret;
+	if (axp2202_capacity(map, &soc))
+		soc = -1;
+	*status = axp2202_status_from_registers(status0, status1, soc);
+	return 0;
+}
