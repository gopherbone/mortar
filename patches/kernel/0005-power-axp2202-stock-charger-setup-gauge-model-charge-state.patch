+/*
+ * Charge state as the stock 4.9 axp2202 driver reports it, made explicit about
+ * the input: COMM_STAT1[2:0] is 1-3 while charging (pre/CC/CV), 4 when charge
+ * is done, 0/5 otherwise. Without VBUS (COMM_STAT0 bit 5) the battery can only
+ * discharge, whatever a stale charge-done code says. With VBUS but no charge
+ * cycle, a full gauge is Full (stock does the same); anything else is a
+ * paused charger (thermal/JEITA window, input limit), not discharging.
+ */
+static inline int axp2202_status_from_registers(unsigned int status0,
+						unsigned int status1,
+						int soc)
+{
+	if (!(status0 & BIT(3)))
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	if (!(status0 & BIT(5)))
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	switch (status1 & GENMASK(2, 0)) {
+	case 1:
+	case 2:
+	case 3:
+		return POWER_SUPPLY_STATUS_CHARGING;
+	case 4:
+		return POWER_SUPPLY_STATUS_FULL;
+	default:
+		return soc == 100 ? POWER_SUPPLY_STATUS_FULL :
+				    POWER_SUPPLY_STATUS_NOT_CHARGING;
+	}
+}
