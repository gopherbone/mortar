+/*
+ * Stock (TrimUI 4.9 axp2202_battery/axp2202_usb_power) charger setup. The
+ * values are the shipped device tree's, encoded the way the stock probe
+ * encodes them: pmu_init_chgvol 4200 mV, pmu_terminal_chgcur 128 mA (driver
+ * default), pre-charge code 2 (hard-coded), pmu_bat_ts_current 50 uA,
+ * pmu_bat_charge_ltf/htf 1390/206 mV, pmu_bat_shutdown_ltf/htf 2190/150 mV,
+ * pmu_jetia_en with cool/warm 722/196 mV and both current fall-backs,
+ * pmu_battery_warning_level1/2 5 %/0 %, pmu_usbad_vol 4000 mV (VINDPM).
+ */
+#define AXP2202_VINDPM		0x16
+#define AXP2202_RESET_CFG	0x18
+#define AXP2202_GAUGE_RESET	BIT(2)
+#define AXP2202_CHARGER_ENABLE	BIT(1)
+#define AXP2202_GAUGE_THLD	0x1b
+#define AXP2202_VOFF		0x24
+#define AXP2202_TS_CFG		0x50
+#define AXP2202_JEITA_CFG	0x58
+#define AXP2202_JEITA_CV_CFG	0x59
+#define AXP2202_PRECHARGE	0x61
+#define AXP2202_TERM_CURRENT	0x63
+#define AXP2202_CHARGE_VOLTAGE	0x64
+#define AXP2202_CV_MASK		GENMASK(2, 0)
+#define AXP2202_CV_4200MV	2
+#define AXP2202_TERM_STEP_UA	64000
+#define AXP2202_BROM		0xa1
+#define AXP2202_BROM_OPEN	BIT(0)
+#define AXP2202_MODEL_LOADED	BIT(4)
+#define AXP2202_TIME_TO_EMPTY	0xa6
+#define AXP2202_TIME_TO_FULL	0xa8
+#define AXP2202_GAUGE_ADDR	0xb0
+#define AXP2202_GAUGE_DATA	0xb2
+#define AXP2202_GAUGE_COULOMB	0x2e
+#define AXP2202_MODEL_PROPERTY	"trimui,battery-model"
+#define AXP2202_MODEL_MAX	512
+
+#define BRICK_CHARGE_VOLTAGE_UV	4200000
+#define BRICK_DESIGN_UAH	3000000	/* pmu_battery_cap */
+/* Stock's 100 % sanity floor: a "full" gauge below this is not initialized. */
+#define BRICK_FULL_MIN_UV	3450000
+
+static const struct {
+	u8 reg, mask, value;
+} brick_charger_setup[] = {
+	{ AXP2202_VINDPM, GENMASK(3, 0), (4000 - 3880) / 80 },
+	{ AXP2202_PRECHARGE, GENMASK(3, 0), 2 },
+	{ AXP2202_TERM_CURRENT, GENMASK(3, 0), 128000 / AXP2202_TERM_STEP_UA },
+	/* TS pin measures the NTC (bit 4 clear) with a 50 uA source. */
+	{ AXP2202_TS_CFG, BIT(4) | GENMASK(1, 0), 2 },
+	{ 0x54, 0xff, 1390 / 32 },
+	{ 0x55, 0xff, 206 / 2 },
+	{ 0x56, 0xff, 2190 / 32 },
