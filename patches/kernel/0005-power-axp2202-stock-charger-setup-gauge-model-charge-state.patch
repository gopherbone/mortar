+/* Gauge estimate in minutes, big endian; median of three like stock. */
+static int axp2202_gauge_time(struct regmap *map, unsigned int reg,
+			      int wanted_status, int *seconds)
+{
+	int values[3], status, ret, i;
+	u8 data[2];
+
+	ret = axp2202_battery_status(map, &status);
+	if (ret)
+		return ret;
+	if (status != wanted_status)
+		return -ENODATA;
+	for (i = 0; i < ARRAY_SIZE(values); i++) {
+		ret = regmap_bulk_read(map, reg, data, sizeof(data));
+		if (ret)
+			return ret;
+		values[i] = (data[0] << 8) | data[1];
 	}
+	if (values[0] > values[1])
+		swap(values[0], values[1]);
+	if (values[1] > values[2])
+		swap(values[1], values[2]);
+	if (values[0] > values[1])
+		swap(values[0], values[1]);
+	if (!values[1] || values[1] == 0xffff)
+		return -ENODATA;
+	*seconds = values[1] * 60;
 	return 0;
 }
 
