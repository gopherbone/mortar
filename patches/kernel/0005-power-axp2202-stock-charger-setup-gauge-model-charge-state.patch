+	{ 0x5a, 0xff, 722 / 16 },
+	{ 0x5b, 0xff, 196 / 8 },
+	{ AXP2202_JEITA_CV_CFG, GENMASK(7, 4), BIT(6) | BIT(4) },
+	/* Level 1 is 5 % + 1 % per step, level 2 1 % per step. */
+	{ AXP2202_GAUGE_THLD, 0xff, ((5 - 5) << 4) | 0 },
+};
