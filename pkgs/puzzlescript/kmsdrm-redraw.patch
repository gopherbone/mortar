PuzzleScript SDL shell: redraw after KMSDRM surface rebuilds; opaque canvas texture.

SDL 3.4 KMSDRM rebuilds its GBM/EGL surface at the first present after a
fullscreen change and drops what was drawn before it, so the dirty-driven
shell showed a black screen until the first input. Also draw the canvas
texture without blending: with llvmpipe, blending reads the uncached
scanout buffer back.

diff --git a/sdl/src/main.rs b/sdl/src/main.rs
index 739890d..0564117 100644
--- a/sdl/src/main.rs
+++ b/sdl/src/main.rs
@@ -378,7 +378,7 @@ fn main() {
     };
     let (w, h) = if o.headless { (o.size.0 as i32, o.size.1 as i32) } else { pixel_size(&canvas) };
     let mut cv = gfx::Canvas::new(w, h);
-    let mut tex = tc.create_texture_streaming(PixelFormat::ARGB8888, w as u32, h as u32).ok();
+    let mut tex = opaque(tc.create_texture_streaming(PixelFormat::ARGB8888, w as u32, h as u32).ok());
 
     let mut audio = audio::Audio::new(audio_sys.as_ref());
     audio.muted = o.mute;
@@ -400,6 +400,10 @@ fn main() {
     let mut script = o.script.as_deref().map(Script::load);
