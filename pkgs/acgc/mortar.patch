+            else if (kc <= 11) EMIT("        vec3 kc = vec3(0.0);\n");
+            else if (kc <= 15) EMIT("        vec3 kc = k%d.rgb;\n", kc - 12);
+            else EMIT("        vec3 kc = vec3(k%d.%c);\n", (kc - 16) & 3, ch[((kc - 16) >> 2) & 3]);
+            if (ka <= 7) EMIT("        float ka = %d.0 / 8.0;\n", 8 - ka);
+            else if (ka <= 15) EMIT("        float ka = 0.0;\n");
+            else EMIT("        float ka = k%d.%c;\n", (ka - 16) & 3, ch[((ka - 16) >> 2) & 3]);
