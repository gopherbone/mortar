+                "tx.rgb", "vec3(tx.a)", "rs.rgb", "vec3(rs.a)", "vec3(1.0)", "vec3(0.5)", "kc", "vec3(0.0)" };
+            static const char* const aarg[8] = { "prev.a", "r0.a", "r1.a", "r2.a", "tx.a", "rs.a", "ka", "0.0" };
+            const u8* ci = k->st[s].cin;
+            const u8* ai = k->st[s].ain;
+            EMIT("        vec3 c = %s %c mix(%s, %s, %s);\n", carg[ci[3] & 15], k->st[s].cop == 1 ? '-' : '+',
