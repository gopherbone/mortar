+#pragma once
+/*
+ * Mortar: gamepad navigation for the original UI.
+ *
+ * Every screen is a State holding widgets, and every widget turns mouse events
+ * into clicks. PadNav finds the widgets of the current screen, keeps one in
+ * focus, and sends the same hover and click events a mouse would, so rules,
+ * sounds and tooltips run unchanged. Four screens get their own cursor:
+ * Battlescape (tiles), Geoscape (the globe under a reticle), Inventory (slot
+ * cells) and the Base view (facility grid). A real mouse keeps working.
+ */
+#include <SDL.h>
+#include <map>
+#include <list>
+#include <vector>
+#include <set>
+#include <string>
+#include "../Battlescape/Position.h"
+
+namespace OpenXcom
+{
+
+class Game;
+class State;
+class Surface;
+class InteractiveSurface;
+class TextList;
+class TextEdit;
+class Globe;
+class BattlescapeState;
+class InventoryState;
+class BaseView;
+class RuleInventory;
+class Text;
+
+class PadNav
+{
+public:
+	enum Btn { UP, DOWN, LEFT, RIGHT, A, B, X, Y, L1, R1, L2, R2, SELECT, START, F1, F2, BTN_COUNT };
+
+	PadNav(Game *game);
+	/// Takes joystick events; true when the event was consumed.
+	bool handle(const SDL_Event &ev);
+	/// Once per main-loop pass: repeats, holds, following the screen.
+	void think();
+	/// Draws the focus on top of the finished frame.
+	void blit(Surface *screen);
+	/// Where the pad's pointer is, in display coordinates.
+	void pointer(int *x, int *y) const;
+	/// The pad has been used since the last real mouse movement.
+	bool active() const { return _active; }
+	/// A real mouse moved: its pointer comes back until the pad is used again.
+	void mouseMoved();
+	/// Marks events PadNav made itself.
+	static const Uint8 SYNTHETIC = 0x7f;
+
+private:
+	enum Mode { GENERIC, BATTLE, GLOBE, INVENTORY, BASE, TEXT };
+	struct Cell { RuleInventory *rule; int sx, sy, cx, cy, w, h; };
+
+	Game *_game;
+	bool _down[BTN_COUNT];
+	Uint32 _downAt[BTN_COUNT], _nextRepeat[BTN_COUNT];
+	bool _chord[BTN_COUNT];
+	bool _held[BTN_COUNT];
+	bool _active;
+	int _px, _py;
+	Uint32 _ctrlUntil;
+
+	State *_state;
+	Mode _mode;
+	bool _panel; // focus is in the original buttons, not the custom cursor
+	InteractiveSurface *_focus;
+	int _row;
+	std::map<State*, InteractiveSurface*> _remembered;
+	InteractiveSurface *_pressedArrow;
+	SDL_Rect _lastFocus;
+	Uint8 _pressedArrowButton;
+
+	// Battlescape
+	Position _tile;
+	void *_lastUnit;
+	bool _lastTargeting;
+	Position _lastOffset;
+	int _enemy;
+	// Inventory
+	std::vector<Cell> _cells;
+	int _cell;
+	// Base
+	int _gx, _gy;
+	// Globe
+	int _contact;
+	int _dogfight;
+	// Naming
+	TextEdit *_finishEdit;
+	State *_finishState;
+	bool _rotating[4];
+
+	// input
+	void press(Btn b);
+	void release(Btn b, Uint32 heldFor);
+	void repeat(Btn b);
+	bool isDirection(Btn b) const { return b <= RIGHT; }
+
+	// sending events
+	void movePointer(int x, int y);
+	void mouse(Uint8 button, bool down);
+	void click(Uint8 button = SDL_BUTTON_LEFT);
+	void key(SDLKey sym);
+	void keyEdge(SDLKey sym, bool down);
+
+	// One line of help, the first time you reach each kind of screen. It goes
+	// on your next press and doesn't come back.
+	std::set<std::string> _hintsSeen;
+	std::string _hintId;
+	const char *_hintText;
+	Text *_hint;
+	bool _hintShown;
+	void armHint(State *s);
+	void dismissHint();
+	void drawHint(Surface *screen);
+
+	// which screen
+	State *activeState() const;
+	void enterState(State *s);
+	Mode modeOf(State *s) const;
+	TextEdit *editing(State *s) const;
+
+	// generic focus
+	void collect(std::vector<InteractiveSurface*> &out, bool noBackground) const;
+	bool usable(InteractiveSurface *s) const;
+	bool isBackground(InteractiveSurface *s) const;
+	bool handlesKey(SDLKey k) const;
+	bool handlesRightClick() const;
+	InteractiveSurface *background() const;
+	void chooseFocus();
+	void setFocus(InteractiveSurface *s);
+	void pointAtFocus();
+	bool moveFocus(int dx, int dy);
+	void genericPress(Btn b);
+	void genericRepeat(Btn b);
+	void genericBack();
+	void genericStart();
+	bool nudgeRow(int delta);
+	void pageRow(int delta);
+	InteractiveSurface *arrowOf(TextList *list, bool more) const;
