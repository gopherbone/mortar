+	void stopRotating();
+
+	InventoryState *inventory() const;
+	void inventoryBuild();
+	void inventoryPress(Btn b);
+	void inventoryMove(int dx, int dy);
+	void inventoryPoint();
+	void *itemAt(const Cell &c) const;
+
+	BaseView *baseView() const;
+	void basePress(Btn b);
+	void basePoint();
+
+	void textPress(Btn b);
+
+	Uint8 _lift[256];
+	Uint32 _liftKey;
+	int nearestColour(Surface *s, int r, int g, int b) const;
+	void drawFocus(Surface *screen);
+	void shade(Surface *screen, int x, int y, int w, int h);
+};
+
+}
