+#ifdef MORTAR_BUILD
+// One textured quad per ASCII glyph, not a fill rect per pixel: a full pattern
+// screen is about 30000 rects, 100 ms a frame on the Brick's A53s.
+static constexpr int atlasCols = 16, atlasRows = 6, atlasCellW = 6, atlasCellH = 8;
+static SDL_Texture* asciiAtlas(SDL_Renderer* renderer) {
+    static SDL_Renderer* owner = nullptr;
+    static SDL_Texture* atlas = nullptr;
+    if (owner == renderer) return atlas;
+    owner = renderer;
+    atlas = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STATIC,
+                              atlasCols * atlasCellW, atlasRows * atlasCellH);
+    if (!atlas) return nullptr;
+    std::array<Uint32, atlasCols * atlasCellW * atlasRows * atlasCellH> pixels{};
+    for (char32_t c = 32; c < 128; ++c) {
+        const auto* glyph = asciiGlyph(c);
+        if (!glyph) continue;
+        const int cell = int(c) - 32, ox = cell % atlasCols * atlasCellW, oy = cell / atlasCols * atlasCellH;
+        for (int row = 0; row < 7; ++row) for (int col = 0; col < 5; ++col)
+            if ((*glyph)[row] & (1 << (4 - col)))
+                pixels[std::size_t((oy + row) * atlasCols * atlasCellW + ox + col)] = 0xffffffffu;
+    }
+    SDL_UpdateTexture(atlas, nullptr, pixels.data(), atlasCols * atlasCellW * int(sizeof(Uint32)));
+    SDL_SetTextureBlendMode(atlas, SDL_BLENDMODE_BLEND);
+    return atlas;
+}
+#endif
