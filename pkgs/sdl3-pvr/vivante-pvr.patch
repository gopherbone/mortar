+/* PowerVR NULL WSEGL: GLES only, so default GL requests (e.g. a window
+   created with SDL_WINDOW_OPENGL before any renderer) to ES 2.0. */
+static void VIVANTE_GLES_DefaultProfileConfig(SDL_VideoDevice *_this, int *mask, int *major, int *minor)
+{
+    *mask = SDL_GL_CONTEXT_PROFILE_ES;
+    *major = 2;
+    *minor = 0;
+}
