+/* The virtual pad's buttons as the stock pad reports them (gamepad.h): a hat, L2/R2 on axes.
+ * Returns FALSE to drop the event. */
+static gboolean mortar_pad_event(SDL_Event *ev)
+{
+    static const int buttons[] = { BTN_B, BTN_A, BTN_X, BTN_Y, BTN_L1, BTN_R1, -1, -1,
+                                   BTN_SELECT, BTN_START, BTN_MENU, -1, -1, -1, -1, BTN_9, BTN_10 };
+    if (ev->type != SDL_JOYBUTTONDOWN && ev->type != SDL_JOYBUTTONUP)
+        return TRUE;
+    if (!app.joystick || SDL_JoystickNumButtons(app.joystick) != MORTAR_PAD_BUTTONS)
+        return TRUE;
+    int button = ev->jbutton.button;
+    gboolean down = ev->type == SDL_JOYBUTTONDOWN;
+    if (g_getenv("WPE_TSP_INPUT_DEBUG"))
+        fprintf(stderr, "[wpe-tsp] pad button %d %s\n", button, down ? "down" : "up");
+    if (button >= MORTAR_PAD_BUTTONS)
+        return FALSE;
+    if (button == 6 || button == 7) {
+        SDL_Event axis = { 0 };
+        axis.type = SDL_JOYAXISMOTION;
+        axis.jaxis.axis = button == 6 ? AXIS_L2 : AXIS_R2;
+        axis.jaxis.value = down ? 32767 : 0;
+        *ev = axis;
+        return TRUE;
+    }
+    if (button >= 11 && button <= 14) {
+        static const guint8 hats[] = { SDL_HAT_UP, SDL_HAT_DOWN, SDL_HAT_LEFT, SDL_HAT_RIGHT };
+        app.pad_hat = down ? app.pad_hat | hats[button - 11] : app.pad_hat & ~hats[button - 11];
+        SDL_Event hat = { 0 };
+        hat.type = SDL_JOYHATMOTION;
+        hat.jhat.value = app.pad_hat;
+        *ev = hat;
+        return TRUE;
+    }
+    ev->jbutton.button = (Uint8)buttons[button];
+    return TRUE;
+}
+
+/* Whether the shell has suspended the window. SDL3 reports that as OCCLUDED, which sdl2-compat
+ * drops from the events it passes on, so ask SDL3 itself about the same window. */
+static gboolean window_occluded(void)
+{
+    static Uint64 (*get_flags)(SDL_Window *);
+    static gboolean looked;
+    if (!looked) {
+        looked = TRUE;
+        void *sdl3 = dlopen("libSDL3.so.0", RTLD_LAZY | RTLD_NOLOAD);
+        if (sdl3)
+            get_flags = (Uint64 (*)(SDL_Window *))dlsym(sdl3, "SDL_GetWindowFlags");
+        if (!get_flags)
+            fprintf(stderr, "[wpe-tsp] no SDL3 underneath: can't tell when hidden\n");
+    }
+    return get_flags && app.window && (get_flags(app.window) & 0x4 /* SDL_WINDOW_OCCLUDED */);
+}
+
+/* Not on screen: tell WebKit, which stops rendering and throttles the page; audio keeps playing. */
+static void set_hidden(gboolean hidden)
+{
+    fprintf(stderr, "[wpe-tsp] %s\n", hidden ? "hidden: page paused" : "on screen");
+    app.hidden = hidden;
+    hid_set_active(!hidden);
+    WPEToplevel *toplevel = wpe_view_get_toplevel(app.wpe_view);
+    if (toplevel)
+        wpe_toplevel_state_changed(toplevel, hidden ? WPE_TOPLEVEL_STATE_FULLSCREEN
+                                                    : WPE_TOPLEVEL_STATE_FULLSCREEN | WPE_TOPLEVEL_STATE_ACTIVE);
+    /* The view keeps its focus: losing it would blur the field and close the on-screen keyboard. */
+    if (hidden) {
+        wpe_view_unmap(app.wpe_view);
+    } else {
+        wpe_view_map(app.wpe_view);
+        app.needs_present = TRUE;
+    }
+}
